diff --git a/Telegram/SourceFiles/window/themes/classic_theme.cpp b/Telegram/SourceFiles/window/themes/classic_theme.cpp
new file mode 100644
index 0000000..334adb9
--- /dev/null
+++ b/Telegram/SourceFiles/window/themes/classic_theme.cpp
@@ -0,0 +1,42 @@
+#include "window/themes/classic_theme.h"
+
+#include "core/application.h"
+#include "core/core_settings.h"
+#include "ui/ui_utility.h"
+
+#include <QtWidgets/QApplication>
+
+namespace Window::Theme::Classic {
+namespace {
+
+constexpr auto kWallpaperVisible = "wecid-classic/wallpaper-visible";
+
+rpl::event_stream<bool> &VisibilityChanges() {
+	static auto result = rpl::event_stream<bool>();
+	return result;
+}
+
+} // namespace
+
+bool WallpaperVisible() {
+	return Core::App().settings().readPref<bool>(kWallpaperVisible, false);
+}
+
+void SetWallpaperVisible(bool visible) {
+	if (WallpaperVisible() == visible) {
+		return;
+	}
+	Core::App().settings().writePref<bool>(kWallpaperVisible, visible);
+	Core::App().saveSettingsDelayed();
+	VisibilityChanges().fire_copy(visible);
+	for (const auto widget : QApplication::topLevelWidgets()) {
+		Ui::ForceFullRepaint(widget);
+	}
+}
+
+rpl::producer<bool> WallpaperVisibilityValue() {
+	return rpl::single(WallpaperVisible())
+		| rpl::then(VisibilityChanges().events());
+}
+
+} // namespace Window::Theme::Classic
