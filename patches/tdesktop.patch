+
+namespace Window {
+namespace {
+
+constexpr auto kStatusRefreshInterval = 1000;
+
+} // namespace
+
+object_ptr<Ui::RpWidget> CreateClassicMenu(MainWindow *owner) {
+	auto result = object_ptr<Ui::RpWidget>(owner->body().get());
+	const auto raw = result.data();
+	const auto bar = new QMenuBar(raw);
+	bar->setNativeMenuBar(false);
+	bar->setFont(st::normalFont->f);
+	const auto updatePalette = [=] {
+		bar->setStyleSheet(uR"(
+QMenuBar { background: %1; color: %2; }
+QMenuBar::item { background: transparent; }
+QMenuBar::item:selected { background: %3; color: %4; }
+QMenu { background: %1; color: %2; border: %5px solid %6; }
+QMenu::item:selected { background: %3; color: %4; }
+QMenu::item:disabled { color: %6; }
+)"_q.arg(
+			Ui::Classic::Surface().name(),
+			Ui::Classic::Text().name(),
+			st::windowBgActive->c.name(),
+			st::windowFgActive->c.name(),
+			QString::number(st::lineWidth),
+			st::windowSubTextFg->c.name()));
+	};
+	updatePalette();
+	style::PaletteChanged() | rpl::on_next(updatePalette, raw->lifetime());
+	const auto file = bar->addMenu(tr::lng_classic_menu_file(tr::now));
+	file->addAction(tr::lng_classic_minimize(tr::now), owner, [=] {
+		owner->showMinimized();
+	});
+	file->addAction(tr::lng_classic_close(tr::now), owner, [=] {
+		owner->close();
+	});
+	const auto view = bar->addMenu(tr::lng_classic_menu_view(tr::now));
+	const auto wallpaper = view->addAction(
+		tr::lng_classic_wallpaper_visible(tr::now));
+	wallpaper->setCheckable(true);
+	Theme::Classic::WallpaperVisibilityValue(
+	) | rpl::on_next([=](bool visible) {
+		wallpaper->setChecked(visible);
+	}, raw->lifetime());
+	QObject::connect(wallpaper, &QAction::triggered, raw, [](bool visible) {
+		Theme::Classic::SetWallpaperVisible(visible);
+	});
+	bar->addAction(tr::lng_menu_contacts(tr::now), owner, [=] {
+		if (const auto controller = owner->sessionController()) {
+			controller->show(PrepareContactsBox(controller));
+		}
+	});
+	bar->addAction(tr::lng_menu_settings(tr::now), owner, [=] {
+		owner->controller().showSettings();
+	});
+	bar->addAction(tr::lng_classic_menu_help(tr::now), owner, [] {
+		QDesktopServices::openUrl(QUrl(u"https://telegram.org/faq"_q));
+	});
+	raw->sizeValue() | rpl::on_next([=](QSize size) {
+		bar->setGeometry(QRect(QPoint(), size));
+	}, raw->lifetime());
+	raw->show();
+	return result;
+}
+
+object_ptr<Ui::RpWidget> CreateClassicStatus(MainWindow *owner) {
+	auto result = object_ptr<Ui::RpWidget>(owner->body().get());
+	const auto raw = result.data();
+	raw->setAttribute(Qt::WA_OpaquePaintEvent);
+	raw->paintRequest() | rpl::on_next([=] {
+		auto p = QPainter(raw);
+		Ui::Classic::Panel(
+			p,
+			raw->rect(),
+			Ui::Classic::Surface(),
+			st::lineWidth,
+			Ui::Classic::Relief::Sunken);
+		const auto signedIn = owner->account().sessionExists();
+		const auto connected = signedIn
+			&& owner->account().mtp().dcstate() == MTP::ConnectedState;
+		const auto text = !signedIn
+			? tr::lng_classic_signed_out(tr::now)
+			: connected
+			? tr::lng_classic_connected(tr::now)
+			: tr::lng_status_connecting(tr::now);
+		const auto dot = st::classicStatusDot;
+		const auto gap = st::classicChromeGap;
+		p.fillRect(
+			QRect(gap, (raw->height() - dot) / 2, dot, dot),
+			connected ? QColor(0, 192, 0) : QColor(128, 128, 128));
+		p.setFont(st::normalFont->f);
+		p.setPen(Ui::Classic::Text());
+		p.drawText(
+			raw->rect().adjusted(gap + dot + gap, 0, -gap, 0),
+			Qt::AlignVCenter | Qt::AlignLeft,
+			text);
+	}, raw->lifetime());
+	const auto timer = new QTimer(raw);
+	QObject::connect(timer, &QTimer::timeout, raw, [=] {
+		raw->update();
+	});
+	timer->start(kStatusRefreshInterval);
+	raw->show();
+	return result;
+}
+
+} // namespace Window
