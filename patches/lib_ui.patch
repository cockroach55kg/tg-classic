diff --git a/ui/classic_style.h b/ui/classic_style.h
new file mode 100644
index 0000000..87be965
--- /dev/null
+++ b/ui/classic_style.h
@@ -0,0 +1,87 @@
+#pragma once
+
+#include "ui/style/style_core.h"
+#include "styles/palette.h"
+
+#include <QtGui/QPainter>
+
+#include <algorithm>
+
+namespace Ui::Classic {
+
+enum class Relief {
+	Raised,
+	Sunken,
+};
+
+inline QColor Surface() {
+	return st::windowBg->c;
+}
+
+inline QColor Title() {
+	return (Surface().lightness() < 128)
+		? st::windowBgActive->c.darker(160)
+		: st::titleBgActive->c;
+}
+
+inline QColor TitleText() {
+	return st::windowFgActive->c;
+}
+
+inline QColor Text() {
+	return st::windowFg->c;
+}
+
+inline void Frame(
+		QPainter &p,
+		QRect rect,
+		int unit,
+		Relief relief = Relief::Raised) {
+	unit = std::max(unit, 1);
+	if (rect.width() < 4 * unit || rect.height() < 4 * unit) {
+		return;
+	}
+	p.save();
+	p.setRenderHint(QPainter::Antialiasing, false);
+	const auto sunken = (relief == Relief::Sunken);
+	const auto surface = Surface();
+	const auto night = surface.lightness() < 128;
+	const auto light = night ? surface.lighter(180) : QColor(255, 255, 255);
+	const auto face = night ? surface.lighter(135) : QColor(223, 223, 223);
+	const auto shadow = night ? surface.darker(135) : QColor(128, 128, 128);
+	const auto dark = night ? surface.darker(200) : QColor(64, 64, 64);
+	const auto edge = [&](QRect area, QColor top, QColor bottom) {
+		p.fillRect(area.x(), area.y(), area.width(), unit, top);
+		p.fillRect(area.x(), area.y(), unit, area.height(), top);
+		p.fillRect(
+			area.x() + unit,
+			area.y() + area.height() - unit,
+			area.width() - unit,
+			unit,
+			bottom);
+		p.fillRect(
+			area.x() + area.width() - unit,
+			area.y() + unit,
+			unit,
+			area.height() - unit,
+			bottom);
+	};
+	edge(rect, sunken ? shadow : light, sunken ? light : dark);
+	edge(
+		rect.adjusted(unit, unit, -unit, -unit),
+		sunken ? dark : face,
+		sunken ? face : shadow);
+	p.restore();
+}
+
+inline void Panel(
+		QPainter &p,
+		QRect rect,
+		QColor fill,
+		int unit,
+		Relief relief = Relief::Raised) {
+	p.fillRect(rect, fill);
+	Frame(p, rect, unit, relief);
+}
+
+} // namespace Ui::Classic
